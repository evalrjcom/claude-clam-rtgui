# Single source of truth for upstream versions.  CI never downloads "latest": every artifact is pinned and sha256-verified.
# Update with:  tools/bump_clamav.sh <version>      (the clamav-watch workflow does this and opens a PR)
CLAMAV_VERSION=1.5.4
CLAMAV_SRC_URL=https://github.com/Cisco-Talos/clamav/releases/download/clamav-1.5.4/clamav-1.5.4.tar.gz
CLAMAV_SRC_SHA256=
CLAMAV_WIN_URL=https://github.com/Cisco-Talos/clamav/releases/download/clamav-1.5.4/clamav-1.5.4.win.x64.zip
CLAMAV_WIN_SHA256=
FLTK_VERSION=1.3.9
FLTK_URL=https://github.com/fltk/fltk/releases/download/release-1.3.9/fltk-1.3.9-source.tar.gz
FLTK_SHA256=
